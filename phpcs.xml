<?xml version="1.0"?>
<ruleset name="ESIT">

    <description>
        PHP coding standards for ESIT.
    </description>

    <file>include</file>
    <file>public</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg name="extensions" value="php"/>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

</ruleset>
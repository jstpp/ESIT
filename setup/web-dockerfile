FROM node:22-alpine AS npm

WORKDIR /build

COPY ./setup/npm/* ./
COPY ./setup/npm/setup/ ./setup/

RUN npm ci
RUN npm run build-chartjs
RUN npm run build-sortablejs

FROM nginx:1-alpine

ARG UID
ARG GID
 
ENV UID=${UID}
ENV GID=${GID}

RUN addgroup -g ${GID} --system esit-group
RUN adduser -G esit-group --system -D -s /bin/sh -u ${UID} esit-user

COPY ./public/portal/sites /www/esit/public
COPY ./public/include /www/esit/public/include
COPY ./public/portal/css /www/esit/public/include/css
COPY ./public/portal/elements /www/esit/public/include/elements
COPY ./public/app /www/esit/public/app
COPY ./public/login /www/esit/public/login

COPY --from=npm /build/node_modules/tinymce /www/esit/public/include/js/tinymce
COPY --from=npm /build/node_modules/ace-builds /www/esit/public/include/js/ace-builds
COPY --from=npm /build/node_modules/mathjax /www/esit/public/include/js/mathjax
COPY --from=npm /build/node_modules/sortablejs /www/esit/public/include/js/sortablejs
COPY --from=npm /build/node_modules/chart.js /www/esit/public/include/js/chart.js
RUN chmod -R 0777 /www/esit/public/include/js/*

RUN chown -R esit-user:esit-group /www/esit/public/*
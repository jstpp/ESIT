#  `mysql` container
MYSQL_ROOT_PASSWORD=esit_db_root
MYSQL_DATABASE=esit_db
MYSQL_USER=esit_db
MYSQL_PASSWORD=esit_db

#  `rabbitmq` container
RABBITMQ_DEFAULT_USER=esit_user
RABBITMQ_DEFAULT_PASS=123456
RABBITMQ_MANAGEMENT.LOAD_DEFINITIONS=/etc/rabbitmq/rabbitmq-definitions.json        #  /setup/definitions.rabbitmq.json.example

# ` worker` container
WORKER_MAX_COMPILATION_MEMORY=1028                                                  #  in KiB
WORKER_MAX_COMPILATION_TIME=60                                                      #  in seconds

#  network settings
NETWORK_PRIVATE_KEY="write_something_complicated_here!"                             # value the same as defined in /include/app/core.php
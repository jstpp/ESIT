FROM php:8-fpm-alpine@sha256:fa01fb1645cd0fc566a5f146b099adace33b906571f972f71f2182a7c12d1cd7

ARG UID
ARG GID
 
ENV UID=${UID}
ENV GID=${GID}

RUN apk add zip libzip-dev unzip linux-headers gettext-dev icu-dev musl-locales && docker-php-ext-install pdo_mysql sockets zip gettext intl && docker-php-ext-enable pdo_mysql

RUN addgroup -g ${GID} --system esit-group
RUN adduser -G esit-group --system -D -s /bin/sh -u ${UID} esit-user

RUN sed -i "s/user = www-data/user = esit-user/g" /usr/local/etc/php-fpm.d/www.conf
RUN sed -i "s/group = www-data/group = esit-group/g" /usr/local/etc/php-fpm.d/www.conf

COPY ./public /www/esit/public
RUN chown -R esit-user:esit-group /www/esit/public/*

COPY ./public/portal/sites /www/esit/public
COPY ./public/portal/css /www/esit/public/include/css
COPY ./public/portal/include /www/esit/public/include
COPY ./public/portal/elements /www/esit/public/include/elements
#COPY ./public/img /www/esit/public/img
COPY ./public/include /www/esit/public/include
COPY ./public/app /www/esit/public/app
COPY ./public/login /www/esit/public/login
COPY ./setup/composer_setup.sh /www/esit/public/app/modules/composer/composer_setup.sh
RUN chown -R esit-user:esit-group /www/esit/*

WORKDIR /www/esit/public/app/modules/composer/
RUN source ./composer_setup.sh
RUN php composer.phar install

WORKDIR /
FROM python:3.13-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b AS base
COPY ./worker/requirements.txt /worker/requirements.txt
RUN pip install -r ./worker/requirements.txt 

RUN apt-get -y update && apt-get install -y \
    libc6 \
    libstdc++6 \
    libprotobuf32 \
    libnl-route-3-200

FROM base AS build

RUN apt-get update && apt-get install -y \
    autoconf \
    bison \
    flex \
    gcc \
    g++ \
    git \
    time \
    libprotobuf-dev \
    libnl-route-3-dev \
    libtool \
    make \
    pkg-config \
    protobuf-compiler \
    openjdk-25-jdk

RUN mkdir /worker/inout
RUN mkdir /worker/sandboxing && cd /worker/sandboxing && git clone https://github.com/google/nsjail.git
RUN cd /worker/sandboxing/nsjail && git checkout f100fd9 && make

FROM build AS run

ARG WORKER_UID=10001
ARG WORKER_GID=10001

RUN groupadd --gid "${WORKER_GID}" esit-worker \
    && useradd \
        --uid "${WORKER_UID}" \
        --gid "${WORKER_GID}" \
        --home-dir /home/esit-worker \
        --create-home \
        --shell /usr/sbin/nologin \
        esit-worker

RUN rm -rf /var/lib/apt/lists/*
COPY --from=build /worker/sandboxing/nsjail /bin
COPY --chown=root:root ./worker/ /worker/

RUN mkdir -p \
        /worker/inout \
        /worker/solutions \
        /worker/logs \
        /worker/tests/tmp \
    && chown -R "${WORKER_UID}:${WORKER_GID}" \
        /worker/inout \
        /worker/solutions \
        /worker/logs \
        /worker/tests/tmp \
    && chmod 0750 \
        /worker/inout \
        /worker/solutions \
        /worker/logs \
        /worker/tests/tmp

USER ${WORKER_UID}:${WORKER_GID}
